integrator              = md
dt                      = 0.002
nsteps                  = 5000

cutoff-scheme           = Verlet
ns_type                 = grid
nstlist                 = 20
rlist                   = 1.0
rcoulomb                = 1.0
rvdw                    = 1.0
coulombtype             = PME
pbc                     = xyz

tcoupl                  = Nose-Hoover
tc-grps                 = System
tau-t                   = 2.0
ref-t                   = TEMP

pcoupl                  = Berendsen
pcoupltype              = isotropic
tau-p                   = 10.0
compressibility         = 4.5e-5
ref-p                   = 1.0

gen-vel                 = no
continuation            = yes

constraints             = h-bonds
constraint-algorithm    = lincs

nstenergy               = 100
nstlog                  = 100
nstxout-compressed      = 100
