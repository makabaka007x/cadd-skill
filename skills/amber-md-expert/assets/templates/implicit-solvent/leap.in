source leaprc.protein.ff14SBonlysc
complex-amber = loadpdb complex.pdb
set default PBradii mbondi3 
saveAmberParm complex-amber complex-amber.top complex-amber.crd #保存完整的体系top和crd文件
savepdb complex-amber complex-amber.pdb #保存体系结构

